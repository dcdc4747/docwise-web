# 复制本文件为 .env 后按需修改（.env 不提交仓库）
# SQLite 数据库文件路径（相对 backend/ 目录，也可写绝对路径）
DATABASE_URL=sqlite:///./data/docwise.db

# 翻译引擎与 DeepSeek 服务配置（复制后按你的实际路径/密钥填）
# 快档引擎（pdf2zh 克隆 + 包装脚本）
# DOCWISE_ENGINE_PYTHON=D:/.../PDFMathTranslate/.venv/Scripts/python.exe
# DOCWISE_ENGINE_SCRIPT=D:/.../PDFMathTranslate/run_translation.py
# DOCWISE_ENGINE_SERVICE=deepseek
# 中档引擎（BabelDOC 克隆 + 包装脚本，未配则回退快档）
# DOCWISE_ENGINE_MEDIUM_PYTHON=D:/.../BabelDOC/.venv/Scripts/python.exe
# DOCWISE_ENGINE_MEDIUM_SCRIPT=D:/.../BabelDOC/run_translation.py
# DOCWISE_ENGINE_MEDIUM_SERVICE=deepseek
# DeepSeek 翻译服务
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
