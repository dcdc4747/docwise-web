# 复制本文件为 .env 后按需修改（.env 不提交仓库）
# SQLite 数据库文件路径（相对 backend/ 目录，也可写绝对路径）
DATABASE_URL=sqlite:///./data/docwise.db

# ---- 翻译引擎（**已随仓库内置，通常不需要配**）----
# 引擎在 <仓库根>/engine/，它有自己的虚拟环境。第一次使用前执行一次：
#     uv sync --project engine
# 下面这些变量**只有在你把引擎放到别处、或想换一个解释器时**才需要设置；
# 不设置时后端会自动用 engine/.venv 与 engine/run_translation.py。
# DOCWISE_ENGINE_PYTHON=<另一个 python 解释器路径>
# DOCWISE_ENGINE_SCRIPT=<另一个包装脚本路径>
# DOCWISE_ENGINE_SERVICE=deepseek
# 中档（可选）：脚本是 engine/run_translation_medium.py；**不配则回退快档**
# DOCWISE_ENGINE_MEDIUM_PYTHON=<解释器路径>
# DOCWISE_ENGINE_MEDIUM_SCRIPT=<脚本路径>
# DOCWISE_ENGINE_MEDIUM_SERVICE=deepseek
# 参考文献格式化：默认 engine/run_bibliography.py，一般不用配
# DOCWISE_ENGINE_BIBLIOGRAPHY_SCRIPT=<脚本路径>
# DeepSeek 翻译服务
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 前端跨域白名单（逗号分隔追加；默认已允许本地开发端口 5173/4173。
# **同源部署（后端托管前端产物）根本用不上 CORS**，这里只在"前端与后端不同源"、
# 例如手机打开 5173 的开发服务器而 API 在 8000 时才需要：
# DOCWISE_CORS_ORIGINS=http://192.168.1.5:5173

# 同源部署：后端直接托管 frontend/dist，一个地址同时提供页面与接口
# （构建方法见 README「一个地址跑起来」）。设 0 则只提供 API。
# DOCWISE_SERVE_FRONTEND=1
# 产物不在默认位置（<仓库根>/frontend/dist）时指定；相对路径按仓库根解析
# DOCWISE_FRONTEND_DIST=D:/path/to/frontend/dist

# Agent：保存用户自带的模型密钥时用来加密（不配＝拒绝落库，只允许会话内临时用）
# DOCWISE_SECRET=换成一段足够长的随机串
